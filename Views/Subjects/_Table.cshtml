@model PaginatedList<MonHoc>
<table class="table table-striped table-hover align-middle">
    <thead class="table-primary"><tr><th>Mã môn</th><th>Tên môn học</th><th>Tín chỉ</th><th>Số tiết</th><th>Thực hành</th><th>Khoa</th><th class="text-end">@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@(x.MaMH)</td><td>@(x.TenMH)</td><td>@(x.SoTinChi)</td><td>@(x.SoTiet)</td><td>@(x.ThucHanh ? "Có" : "")</td><td>@(x.Khoa?.TenKhoa)</td>
            <td class="text-end text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@x.MaMH" title="@L["Edit"]"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@x.MaMH" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted">@L["NoData"]</td></tr> }
    </tbody>
</table>
<partial name="_Pager" model="Model" />
