@model PaginatedList<LichHoc>
@{ ViewData["Title"] = L["Lookup"].Value; }
<h3 class="mb-3"><i class="bi bi-search"></i> @L["Lookup"]</h3>
<div data-ajax-list data-url="@Url.Action("TraCuu", "Home")" data-form="#filterForm">
  <form id="filterForm" class="row g-2 mb-3">
    <div class="col-12 col-md-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="@L["SearchHint"]" /></div>
    <div class="col-6 col-md-3"><select name="maHK" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.HocKys"><option value="0">— @L["Semester"] —</option></select></div>
    <div class="col-6 col-md-2"><select name="maPhong" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Phongs"><option value="0">— @L["Room"] —</option></select></div>
    <div class="col-6 col-md-2"><select name="thu" class="form-select"><option value="0">— @L["Day"] —</option>@for (int t = 2; t <= 8; t++) { <option value="@t">@TkbHelper.ThuText(t)</option> }</select></div>
    <div class="col-auto"><button class="btn btn-primary" type="submit"><i class="bi bi-funnel"></i> @L["Filter"]</button></div>
  </form>
  <div class="list-container table-responsive">@await Html.PartialAsync("_TraCuuTable", Model)</div>
</div>
