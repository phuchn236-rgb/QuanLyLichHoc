@{
    ViewData["Title"] = L["Home"].Value;
    var hk = ViewBag.HocKy as HocKy;
    bool staff = User.IsInRole("GiaoVu") || User.IsInRole("Admin");
    bool sv = User.IsInRole("SinhVien"), gv = User.IsInRole("GiangVien");
    var today = ViewBag.Today as List<LichDto>;
    var week = ViewBag.Week as List<LichDto>;
}
<div class="p-4 p-lg-5 mb-4 bg-light rounded-3 border">
  <h1 class="display-6 fw-bold">@L["Welcome"]</h1>
  <p class="lead mb-2">@L["WelcomeSub"]</p>
  @if (hk != null) { <p class="mb-3"><span class="badge text-bg-primary">@L["CurrentSemester"]: @hk.Ten</span> <span class="text-muted">(@hk.NgayBatDau.ToString("dd/MM/yyyy") – @hk.NgayKetThuc.ToString("dd/MM/yyyy"))</span>@if (ViewBag.Tuan != null) { <span class="badge text-bg-info ms-2">@L["Week"] @ViewBag.Tuan</span> }</p> }
  <a class="btn btn-primary btn-lg" asp-action="TraCuu"><i class="bi bi-search"></i> @L["Lookup"]</a>
  @if (!User.Identity.IsAuthenticated) { <a class="btn btn-outline-primary btn-lg ms-2" asp-controller="Account" asp-action="Login">@L["Login"]</a> }
  @if (sv || gv) { <a class="btn btn-outline-primary btn-lg ms-2" asp-controller="Timetable" asp-action="Index"><i class="bi bi-calendar3"></i> @L["Timetable"]</a> }
  @if (sv) { <a class="btn btn-success btn-lg ms-2" asp-controller="Registration" asp-action="Index"><i class="bi bi-journal-check"></i> @L["Register"]</a> }
</div>

@if (sv || gv)
{
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card text-center shadow-sm"><div class="card-body"><div class="fs-2 fw-bold text-primary">@ViewBag.SoHP</div><div class="text-muted">@(sv ? "Học phần đã đăng ký" : "Lớp học phần phụ trách")</div></div></div></div>
    @if (sv) { <div class="col-6 col-lg-3"><div class="card text-center shadow-sm"><div class="card-body"><div class="fs-2 fw-bold text-success">@ViewBag.SoTC</div><div class="text-muted">Tổng số tín chỉ</div></div></div></div> }
    <div class="col-6 col-lg-3"><div class="card text-center shadow-sm"><div class="card-body"><div class="fs-2 fw-bold text-info">@(today?.Count ?? 0)</div><div class="text-muted">Buổi học hôm nay</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card text-center shadow-sm"><div class="card-body"><div class="fs-2 fw-bold text-secondary">@(week?.Count ?? 0)</div><div class="text-muted">Buổi học trong tuần</div></div></div></div>
  </div>
  <div class="row g-4">
    <div class="col-12 col-lg-5">
      <div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-sun"></i> Lịch học hôm nay (@DateTime.Today.ToString("dd/MM/yyyy"))</div>
        <ul class="list-group list-group-flush">
          @if (today == null || today.Count == 0) { <li class="list-group-item text-muted">Hôm nay không có buổi học.</li> }
          else { foreach (var x in today.OrderBy(x => x.TietBatDau)) { <li class="list-group-item"><b>@x.TenMon</b><div class="small text-muted">Tiết @x.TietBatDau–@(x.TietBatDau + x.SoTiet - 1) (@x.ThoiGian) · @x.Phong@(sv ? " · " + x.GiangVien : " · " + x.MaLHP)</div></li> } }
        </ul>
      </div>
    </div>
    <div class="col-12 col-lg-7">
      <div class="card shadow-sm h-100"><div class="card-header fw-bold"><i class="bi bi-calendar-week"></i> Lịch học tuần này</div>
        <div class="table-responsive"><table class="table table-sm mb-0 align-middle">
          <thead><tr><th>@L["Day"]</th><th>@L["Period"]</th><th>@L["Subject"]</th><th>@L["Room"]</th></tr></thead>
          <tbody>
          @if (week == null || week.Count == 0) { <tr><td colspan="4" class="text-muted">@(sv ? "Bạn chưa có lịch học trong tuần này. Hãy bấm “Đăng ký học phần” để chọn lớp." : "Chưa có lịch dạy trong tuần này.")</td></tr> }
          else { foreach (var x in week.OrderBy(x => x.Thu).ThenBy(x => x.TietBatDau)) { <tr><td>@x.ThuText</td><td>@x.TietBatDau–@(x.TietBatDau + x.SoTiet - 1)</td><td>@x.TenMon</td><td>@x.Phong</td></tr> } }
          </tbody></table></div>
      </div>
    </div>
  </div>
}
@if (staff)
{
  <div class="row g-3">
    @foreach (var (label, val, icon, ctl) in new[] {
        ((string)L["Students"].Value, (int)ViewBag.SoSV, "bi-mortarboard", "Students"), ((string)L["Lecturers"].Value, (int)ViewBag.SoGV, "bi-person-workspace", "Lecturers"),
        ((string)L["Rooms"].Value, (int)ViewBag.SoPhong, "bi-building", "Rooms"), ((string)L["Sections"].Value, (int)ViewBag.SoLHP, "bi-journal-bookmark", "Sections"),
        ((string)L["Schedules"].Value, (int)ViewBag.SoLich, "bi-calendar-check", "Schedules"), ("Lượt đăng ký học phần", (int)ViewBag.SoDangKy, "bi-journal-check", "Sections") })
    {
      <div class="col-6 col-md-4 col-xl"><a class="text-decoration-none" href="@Url.Action("Index", ctl)"><div class="card text-center h-100 shadow-sm"><div class="card-body"><i class="bi @icon fs-1 text-primary"></i><div class="fs-2 fw-bold">@val</div><div class="text-muted">@label</div></div></div></a></div>
    }
  </div>
}
