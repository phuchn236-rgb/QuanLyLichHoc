@model PaginatedList<LichDto>
@{
    var enrolled = ViewBag.Enrolled as Dictionary<string, List<StudentRow>>;
    int maHK = ViewBag.MaHK is int h ? h : 0;
}
<table class="table table-striped table-hover align-middle">
  <thead class="table-primary"><tr>
    <th>@L["Section"]</th><th>@L["Subject"]</th><th>@L["Lecturer"]</th><th>@L["Room"]</th><th>@L["Day"]</th><th>@L["Period"]</th><th>@L["Time"]</th><th>@L["Weeks"]</th>
    @if (enrolled != null) { <th style="min-width:220px">Sinh viên đăng ký</th> }
  </tr></thead>
  <tbody>
  @foreach (var x in Model)
  {
    <tr>
      <td>@x.MaLHP</td><td>@x.TenMon</td><td>@x.GiangVien</td><td>@x.Phong</td>
      <td>@x.ThuText</td><td>@x.TietBatDau – @(x.TietBatDau + x.SoTiet - 1)</td><td>@x.ThoiGian</td><td>@x.TuanBatDau – @x.TuanKetThuc</td>
      @if (enrolled != null)
      {
        var list = enrolled.GetValueOrDefault(x.MaLHP) ?? new List<StudentRow>();
        <td>
          @if (list.Count == 0) { <span class="text-muted small">Chưa có sinh viên</span> }
          else
          {
            <span class="badge text-bg-success me-1">@list.Count</span>
            <span class="small">@string.Join(", ", list.Take(3).Select(s => s.HoTen))@(list.Count > 3 ? ", …" : "")</span>
            <button type="button" class="btn btn-sm btn-link p-0 ms-1 btn-enrolled" data-lhp="@x.MaLHP" data-hk="@maHK">Xem tất cả</button>
          }
        </td>
      }
    </tr>
  }
  @if (Model.Count == 0) { <tr><td colspan="@(enrolled != null ? 9 : 8)" class="text-center text-muted">@L["NoData"]</td></tr> }
  </tbody>
</table>
<partial name="_Pager" model="Model" />
