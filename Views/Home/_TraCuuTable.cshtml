@model PaginatedList<LichHoc>
<table class="table table-striped table-hover align-middle">
  <thead class="table-primary"><tr><th>@L["Section"]</th><th>@L["Subject"]</th><th>@L["Lecturer"]</th><th>@L["Room"]</th><th>@L["Day"]</th><th>@L["Period"]</th><th>@L["Time"]</th><th>@L["Weeks"]</th></tr></thead>
  <tbody>
  @foreach (var x in Model)
  {
    <tr>
      <td>@x.MaLHP</td><td>@x.LopHocPhan?.MonHoc?.TenMH</td><td>@x.LopHocPhan?.GiangVien?.HoTen</td><td>@x.PhongHoc?.TenPhong</td>
      <td>@TkbHelper.ThuText(x.Thu)</td><td>@x.TietBatDau – @(x.TietBatDau + x.SoTiet - 1)</td><td>@TkbHelper.ThoiGian(x.TietBatDau, x.SoTiet)</td><td>@x.TuanBatDau – @x.TuanKetThuc</td>
    </tr>
  }
  @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted">@L["NoData"]</td></tr> }
  </tbody>
</table>
<partial name="_Pager" model="Model" />
