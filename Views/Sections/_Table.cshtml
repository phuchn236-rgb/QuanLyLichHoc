@model PaginatedList<LopHocPhan>
@{
    var mons = ViewBag.MonNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    var gvs = ViewBag.GvNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    var hks = ViewBag.HkNames as Dictionary<int, string> ?? new Dictionary<int, string>();
    var siso = ViewBag.SiSoMap as Dictionary<string, int> ?? new Dictionary<string, int>();
}
<table class="table table-striped table-hover align-middle">
    <thead class="table-primary"><tr><th>Mã LHP</th><th>Môn học</th><th>Giảng viên</th><th>Học kỳ</th><th>Sĩ số</th><th>Trạng thái</th><th class="text-end">@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        int n = siso.GetValueOrDefault(x.MaLHP, 0);
        <tr>
            <td>@x.MaLHP</td>
            <td>@mons.GetValueOrDefault(x.MaMH, x.MaMH)</td>
            <td>@gvs.GetValueOrDefault(x.MaGV, x.MaGV)</td>
            <td>@hks.GetValueOrDefault(x.MaHK, "—")</td>
            <td><span class="badge @(n >= x.SiSoToiDa ? "text-bg-danger" : n > 0 ? "text-bg-success" : "text-bg-secondary")">@n/@x.SiSoToiDa</span></td>
            <td>@x.TrangThai</td>
            <td class="text-end text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-secondary btn-enrolled" data-lhp="@x.MaLHP" data-hk="@x.MaHK" title="Danh sách sinh viên đăng ký"><i class="bi bi-people"></i></button>
                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@x.MaLHP" title="@L["Edit"]"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@x.MaLHP" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted">@L["NoData"]</td></tr> }
    </tbody>
</table>
<partial name="_Pager" model="Model" />
