@model Lop
@{ bool isNew = (bool)ViewData["IsNew"]; }
<input asp-for="MaLop" type="hidden" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="TenLop" class="form-label"></label><input asp-for="TenLop" type="text" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="KhoaHoc" class="form-label"></label><input asp-for="KhoaHoc" type="number" class="form-control" /></div>
    <div class="col-md-12"><label asp-for="MaKhoa" class="form-label"></label><select asp-for="MaKhoa" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Khoas)" class="form-select"></select></div>
</div>
