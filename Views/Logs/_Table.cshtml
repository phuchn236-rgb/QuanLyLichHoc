@model PaginatedList<NhatKy>
<table class="table table-striped table-sm align-middle">
  <thead class="table-primary"><tr><th>Thời gian</th><th>Người dùng</th><th>Hành động</th><th>Chi tiết</th></tr></thead>
  <tbody>
  @foreach (var n in Model) { <tr><td class="text-nowrap">@n.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@n.NguoiDung</td><td>@n.HanhDong</td><td>@n.ChiTiet</td></tr> }
  @if (Model.Count == 0) { <tr><td colspan="4" class="text-center text-muted">@L["NoData"]</td></tr> }
  </tbody>
</table>
<partial name="_Pager" model="Model" />
