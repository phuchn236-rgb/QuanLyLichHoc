@model Dictionary<string, List<string>>
@{
    ViewData["Title"] = "Kiểm tra dữ liệu";
    var counts = (Dictionary<string, int>)ViewBag.Counts;
    int bad = Model.Where(k => k.Key.Contains("thiếu môn") || k.Key.Contains("Buổi học thiếu") || k.Key.Contains("Đăng ký thiếu")).Sum(k => k.Value.Count);
}
<h3 class="mb-3"><i class="bi bi-heart-pulse"></i> Kiểm tra dữ liệu</h3>
@if (TempData["Fixed"] != null) { <div class="alert alert-success">Đã xóa @TempData["Fixed"] bản ghi lỗi.</div> }
<div class="row g-2 mb-3">
  @foreach (var c in counts) { <div class="col-6 col-md-3 col-xl"><div class="card text-center"><div class="card-body py-2"><div class="fs-4 fw-bold">@c.Value</div><div class="small text-muted">@c.Key</div></div></div></div> }
</div>
@foreach (var kv in Model)
{
  <div class="card mb-3"><div class="card-header d-flex justify-content-between"><b>@kv.Key</b><span class="badge @(kv.Value.Count == 0 ? "text-bg-success" : "text-bg-danger")">@kv.Value.Count</span></div>
    @if (kv.Value.Count == 0) { <div class="card-body text-success small"><i class="bi bi-check-circle"></i> Không có vấn đề.</div> }
    else { <ul class="list-group list-group-flush">@foreach (var x in kv.Value.Take(30)) { <li class="list-group-item small">@x</li> }@if (kv.Value.Count > 30) { <li class="list-group-item small text-muted">… và @(kv.Value.Count - 30) mục khác</li> }</ul> }
  </div>
}
@if (bad > 0)
{
  <form asp-action="Fix" method="post" onsubmit="return confirm('Xóa các bản ghi lỗi (đăng ký, lịch học, lớp học phần bị thiếu liên kết)? Thao tác không thể hoàn tác.');">
    <button class="btn btn-danger"><i class="bi bi-tools"></i> Xóa @bad bản ghi lỗi</button>
  </form>
}
<div class="small text-muted mt-3">Tài khoản chưa liên kết được hệ thống tự nối lại mỗi lần khởi động ứng dụng (nếu tên đăng nhập trùng mã sinh viên / giảng viên).</div>
