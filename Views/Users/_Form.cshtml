@model NguoiDung
@{ bool isNew = (bool)ViewData["IsNew"]; }
<input asp-for="MaND" type="hidden" />
<div class="row g-3">
    <div class="col-md-6"><label asp-for="TenDangNhap" class="form-label"></label><input asp-for="TenDangNhap" type="text" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" type="text" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="VaiTro" class="form-label"></label><select asp-for="VaiTro" asp-items="@((IEnumerable<SelectListItem>)ViewBag.VaiTros)" class="form-select"></select></div>
    <div class="col-md-6"><label asp-for="MatKhauMoi" class="form-label"></label><input asp-for="MatKhauMoi" type="password" class="form-control" value="" /></div>
    <div class="col-md-12"><div class="form-check"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label"></label></div></div>
</div>
<div class="form-text mt-3"><i class="bi bi-info-circle"></i> Khi sửa: để trống ô mật khẩu nếu không muốn đổi. Mật khẩu tối thiểu 8 ký tự.</div>
