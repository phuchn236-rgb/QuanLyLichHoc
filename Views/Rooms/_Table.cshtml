@model PaginatedList<PhongHoc>
<table class="table table-striped table-hover align-middle">
    <thead class="table-primary"><tr><th>Tên phòng</th><th>Loại phòng</th><th>Sức chứa</th><th>Tòa nhà</th><th class="text-end">@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@(x.TenPhong)</td><td>@(x.LoaiPhong == "TH" ? "Thực hành" : "Lý thuyết")</td><td>@(x.SucChua)</td><td>@(x.ToaNha)</td>
            <td class="text-end text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@x.MaPhong" title="@L["Edit"]"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@x.MaPhong" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted">@L["NoData"]</td></tr> }
    </tbody>
</table>
<partial name="_Pager" model="Model" />
