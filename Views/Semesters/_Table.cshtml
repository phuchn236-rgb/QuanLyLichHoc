@model PaginatedList<HocKy>
<table class="table table-striped table-hover align-middle">
    <thead class="table-primary"><tr><th>Tên học kỳ</th><th>Năm học</th><th>Bắt đầu</th><th>Kết thúc</th><th class="text-end">@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@(x.TenHK)</td><td>@(x.NamHoc)</td><td>@(x.NgayBatDau.ToString("dd/MM/yyyy"))</td><td>@(x.NgayKetThuc.ToString("dd/MM/yyyy"))</td>
            <td class="text-end text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@x.MaHK" title="@L["Edit"]"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@x.MaHK" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted">@L["NoData"]</td></tr> }
    </tbody>
</table>
<partial name="_Pager" model="Model" />
