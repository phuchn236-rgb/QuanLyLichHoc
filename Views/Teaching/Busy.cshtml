@model List<LichBan>
@{ ViewData["Title"] = L["Busy"].Value; }
<h3 class="mb-3"><i class="bi bi-clock-history"></i> @L["Busy"]</h3>
<p class="text-muted">Khai báo các khung giờ bạn không thể dạy. Giáo vụ sẽ không thể xếp lịch dạy của bạn vào các khung giờ này.</p>
<div class="row g-4">
  <div class="col-12 col-lg-4">
    <div class="card"><div class="card-body">
      <form id="busyForm">
        <div class="mb-2"><label class="form-label">@L["Day"]</label><select name="thu" class="form-select" asp-items="(IEnumerable<SelectListItem>)ViewBag.Thus"></select></div>
        <div class="row g-2 mb-2">
          <div class="col"><label class="form-label">Tiết bắt đầu</label><input type="number" name="tietBatDau" min="1" max="12" value="1" class="form-control" /></div>
          <div class="col"><label class="form-label">Số tiết</label><input type="number" name="soTiet" min="1" max="12" value="2" class="form-control" /></div>
        </div>
        <div class="mb-3"><label class="form-label">Ghi chú</label><input name="ghiChu" maxlength="200" class="form-control" /></div>
        <div id="busyErr" class="alert alert-danger d-none"></div>
        <button class="btn btn-primary w-100" type="submit"><i class="bi bi-plus-lg"></i> @L["Add"]</button>
      </form>
    </div></div>
  </div>
  <div class="col-12 col-lg-8">
    <table class="table table-striped align-middle">
      <thead class="table-primary"><tr><th>@L["Day"]</th><th>@L["Period"]</th><th>@L["Time"]</th><th>Ghi chú</th><th></th></tr></thead>
      <tbody>
      @foreach (var b in Model)
      {
        <tr><td>@TkbHelper.ThuText(b.Thu)</td><td>@b.TietBatDau – @(b.TietBatDau + b.SoTiet - 1)</td><td>@TkbHelper.ThoiGian(b.TietBatDau, b.SoTiet)</td><td>@b.GhiChu</td>
            <td class="text-end"><button class="btn btn-sm btn-outline-danger btn-del-busy" data-id="@b.MaLichBan"><i class="bi bi-trash"></i></button></td></tr>
      }
      @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted">@L["NoData"]</td></tr> }
      </tbody>
    </table>
  </div>
</div>
@section Scripts {
<script>
$('#busyForm').on('submit', function (e) {
    e.preventDefault();
    $.post('/Teaching/AddBusy', $(this).serialize(), function (r) {
        if (r.ok) location.reload(); else $('#busyErr').removeClass('d-none').html(r.errors.join('<br>'));
    });
});
$(document).on('click', '.btn-del-busy', function () {
    if (!confirm(window.I18N.confirmDelete)) return;
    $.post('/Teaching/DeleteBusy', { id: $(this).data('id') }, function () { location.reload(); });
});
</script>
}
