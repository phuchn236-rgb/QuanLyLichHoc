@model PaginatedList<LichHoc>
<table class="table table-striped table-hover align-middle">
    <thead class="table-primary"><tr><th>Lớp học phần</th><th>Môn học</th><th>Giảng viên</th><th>Phòng</th><th>Thứ</th><th>Tiết</th><th>Tuần</th><th class="text-end">@L["Actions"]</th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@(x.MaLHP)</td><td>@(x.LopHocPhan?.MonHoc?.TenMH)</td><td>@(x.LopHocPhan?.GiangVien?.HoTen)</td><td>@(x.PhongHoc?.TenPhong)</td><td>@(TkbHelper.ThuText(x.Thu))</td><td>@(x.TietBatDau + "-" + (x.TietBatDau + x.SoTiet - 1))</td><td>@(x.TuanBatDau + "-" + x.TuanKetThuc)</td>
            <td class="text-end text-nowrap">
                <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@x.MaLich" title="@L["Edit"]"><i class="bi bi-pencil"></i></button>
                <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@x.MaLich" title="@L["Delete"]"><i class="bi bi-trash"></i></button>
            </td>
        </tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted">@L["NoData"]</td></tr> }
    </tbody>
</table>
<partial name="_Pager" model="Model" />
