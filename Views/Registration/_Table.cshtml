@model PaginatedList<RegRow>
<table class="table table-striped table-hover align-middle">
  <thead class="table-primary"><tr><th>@L["Section"]</th><th>@L["Subject"]</th><th>@L["Credits"]</th><th>@L["Lecturer"]</th><th>@L["Time"]</th><th>@L["Capacity"]</th><th>@L["Status"]</th><th class="text-end">@L["Actions"]</th></tr></thead>
  <tbody>
  @foreach (var r in Model)
  {
    <tr class="@(r.DaDangKy ? "table-success" : "")">
      <td>@r.MaLHP</td><td>@r.TenMon</td><td>@r.SoTinChi</td><td>@r.GiangVien</td><td class="small">@(string.IsNullOrEmpty(r.Lich) ? "—" : r.Lich)</td>
      <td>@r.SiSo/@r.SiSoToiDa</td><td>@r.TrangThai</td>
      <td class="text-end">
        @if (r.DaDangKy) { <button class="btn btn-sm btn-outline-danger btn-unreg" data-id="@r.MaLHP">@L["Unregister"]</button> }
        else if (r.TrangThai == TrangThaiLHP.Mo && r.SiSo < r.SiSoToiDa) { <button class="btn btn-sm btn-success btn-reg" data-id="@r.MaLHP">@L["Register"]</button> }
        else { <span class="text-muted small">—</span> }
      </td>
    </tr>
  }
  @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted">@L["NoData"]</td></tr> }
  </tbody>
</table>
<partial name="_Pager" model="Model" />
