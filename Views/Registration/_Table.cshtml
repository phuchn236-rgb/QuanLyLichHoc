@model PaginatedList<RegRow>
<table class="table table-striped table-hover align-middle">
  <thead class="table-primary"><tr><th>@L["Subject"]</th><th>@L["Section"]</th><th>@L["Lecturer"]</th><th>@L["Time"]</th><th>@L["Capacity"]</th><th class="text-end">@L["Actions"]</th></tr></thead>
  <tbody>
  @foreach (var r in Model)
  {
    <tr class="@(r.DaDangKy ? "table-success" : "")">
      <td><b>@r.TenMon</b><div class="small text-muted">@r.SoTinChi @L["Credits"].Value.ToLower()</div></td>
      <td>@r.MaLHP @if (r.TrangThai != TrangThaiLHP.Mo) { <span class="badge text-bg-secondary">@r.TrangThai</span> }</td>
      <td>@r.GiangVien</td>
      <td class="small">@(string.IsNullOrEmpty(r.Lich) ? "—" : r.Lich)</td>
      <td>@r.SiSo/@r.SiSoToiDa</td>
      <td class="text-end text-nowrap">
        <button class="btn btn-sm btn-outline-secondary btn-preview" data-id="@r.MaLHP" title="Xem trước lịch trên thời khóa biểu"><i class="bi bi-eye"></i> Xem lịch</button>
        @if (r.DaDangKy) { <button class="btn btn-sm btn-outline-danger btn-unreg" data-id="@r.MaLHP">@L["Unregister"]</button> }
        else if (r.TrangThai == TrangThaiLHP.Mo && r.SiSo < r.SiSoToiDa) { <button class="btn btn-sm btn-success btn-reg" data-id="@r.MaLHP">@L["Register"]</button> }
      </td>
    </tr>
  }
  @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted">@L["NoData"]</td></tr> }
  </tbody>
</table>
<partial name="_Pager" model="Model" />
