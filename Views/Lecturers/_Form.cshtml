@model GiangVien
@{ bool isNew = (bool)ViewData["IsNew"]; }

<div class="row g-3">
    <div class="col-md-4"><label asp-for="MaGV" class="form-label"></label><input asp-for="MaGV" type="text" class="form-control" readonly="@(!isNew)" /></div>
    <div class="col-md-8"><label asp-for="HoTen" class="form-label"></label><input asp-for="HoTen" type="text" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="SoDienThoai" class="form-label"></label><input asp-for="SoDienThoai" type="text" class="form-control" /></div>
    <div class="col-md-12"><label asp-for="MaKhoa" class="form-label"></label><select asp-for="MaKhoa" asp-items="@((IEnumerable<SelectListItem>)ViewBag.Khoas)" class="form-select"></select></div>
</div>
<div class="form-text mt-3"><i class="bi bi-info-circle"></i> Khi thêm mới, hệ thống tự tạo tài khoản đăng nhập (tên = mã GV viết thường, mật khẩu mặc định GiangVien@123).</div>
