@{
    var ci = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var fullName = Context.Session.GetString("FullName") ?? User.FindFirst("HoTen")?.Value ?? User.Identity?.Name;
    bool staff = User.IsInRole("GiaoVu") || User.IsInRole("Admin");
    string Active(string c) => (string)ViewContext.RouteData.Values["controller"] == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="@(ci.StartsWith("en") ? "en" : "vi")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @L["AppName"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<header class="no-print">
<nav class="navbar navbar-expand-lg navbar-dark bg-primary">
  <div class="container-fluid">
    <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-calendar-week"></i> @L["AppName"]</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="TraCuu">@L["Lookup"]</a></li>
        @if (User.IsInRole("SinhVien") || User.IsInRole("GiangVien"))
        {
            <li class="nav-item"><a class="nav-link @Active("Timetable")" asp-controller="Timetable" asp-action="Index">@L["Timetable"]</a></li>
        }
        @if (User.IsInRole("SinhVien"))
        {
            <li class="nav-item"><a class="nav-link @Active("Registration")" asp-controller="Registration" asp-action="Index">@L["Register"]</a></li>
        }
        @if (User.IsInRole("GiangVien"))
        {
            <li class="nav-item"><a class="nav-link" asp-controller="Teaching" asp-action="Classes">@L["MyClasses"]</a></li>
            <li class="nav-item"><a class="nav-link" asp-controller="Teaching" asp-action="Busy">@L["Busy"]</a></li>
        }
        @if (staff)
        {
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@L["Catalogs"]</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Rooms" asp-action="Index">@L["Rooms"]</a></li>
                <li><a class="dropdown-item" asp-controller="Subjects" asp-action="Index">@L["Subjects"]</a></li>
                <li><a class="dropdown-item" asp-controller="Semesters" asp-action="Index">@L["Semesters"]</a></li>
                <li><a class="dropdown-item" asp-controller="Faculties" asp-action="Index">@L["Faculties"]</a></li>
                <li><a class="dropdown-item" asp-controller="Classes" asp-action="Index">@L["Classes"]</a></li>
                <li><a class="dropdown-item" asp-controller="Lecturers" asp-action="Index">@L["Lecturers"]</a></li>
                <li><a class="dropdown-item" asp-controller="Students" asp-action="Index">@L["Students"]</a></li>
              </ul>
            </li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">@L["Training"]</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" asp-controller="Sections" asp-action="Index">@L["Sections"]</a></li>
                <li><a class="dropdown-item" asp-controller="Schedules" asp-action="Index">@L["Schedules"]</a></li>
              </ul>
            </li>
            <li class="nav-item"><a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index">@L["Reports"]</a></li>
        }
        @if (User.IsInRole("Admin"))
        {
            <li class="nav-item"><a class="nav-link @Active("Users")" asp-controller="Users" asp-action="Index">@L["Users"]</a></li>
            <li class="nav-item"><a class="nav-link @Active("Logs")" asp-controller="Logs" asp-action="Index">@L["Logs"]</a></li>
        }
      </ul>
      <div class="d-flex align-items-center gap-2">
        <form asp-controller="Home" asp-action="SetLanguage" method="post" class="d-flex gap-1">
          <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
          <button name="culture" value="vi-VN" class="btn btn-sm @(ci == "vi-VN" ? "btn-light" : "btn-outline-light")">VI</button>
          <button name="culture" value="en-US" class="btn btn-sm @(ci == "en-US" ? "btn-light" : "btn-outline-light")">EN</button>
        </form>
        @if (User.Identity.IsAuthenticated)
        {
            <a class="text-white text-decoration-none" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-circle"></i> @fullName</a>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-light">@L["Logout"]</button></form>
        }
        else
        {
            <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Login">@L["Login"]</a>
        }
      </div>
    </div>
  </div>
</nav>
</header>

<main class="container-fluid py-4 px-3 px-lg-5">
    @RenderBody()
</main>

<footer class="text-center text-muted small py-3 border-top no-print">© @DateTime.Now.Year @L["AppName"] — @L["Footer"]</footer>

<form id="afForm" class="d-none">@Html.AntiForgeryToken()</form>
<div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="appToast" class="toast align-items-center text-bg-success border-0" role="alert"><div class="d-flex"><div class="toast-body" id="toastMsg"></div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div></div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>window.I18N = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { confirmDelete = L["ConfirmDelete"].Value, saved = L["Saved"].Value, deleted = L["Deleted"].Value }));</script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
